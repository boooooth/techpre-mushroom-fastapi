# Mushroom Toxicity API Requests
# Start server first: fastapi dev app/main.py --port 8001
@base = http://127.0.0.1:8001

### 1. Health check
GET {{base}}/health

### 2. Model audit & training metrics
GET {{base}}/models

### 3. Predict Single: Poisonous Mushroom (Pungent odor 'p')
POST {{base}}/mushroom/predict
Content-Type: application/json

{
  "cap_shape": "x",
  "cap_surface": "s",
  "cap_color": "n",
  "bruises": "t",
  "odor": "p",
  "gill_attachment": "f",
  "gill_spacing": "c",
  "gill_size": "n",
  "gill_color": "k",
  "stalk_shape": "e",
  "stalk_root": "e",
  "stalk_surface_above_ring": "s",
  "stalk_surface_below_ring": "s",
  "stalk_color_above_ring": "w",
  "stalk_color_below_ring": "w",
  "veil_color": "w",
  "ring_number": "o",
  "ring_type": "p",
  "spore_print_color": "k",
  "population": "s",
  "habitat": "u"
}

### 4. Predict Single: Edible Mushroom (Almond odor 'a')
POST {{base}}/mushroom/predict
Content-Type: application/json

{
  "cap_shape": "x",
  "cap_surface": "s",
  "cap_color": "y",
  "bruises": "t",
  "odor": "a",
  "gill_attachment": "f",
  "gill_spacing": "c",
  "gill_size": "b",
  "gill_color": "k",
  "stalk_shape": "e",
  "stalk_root": "c",
  "stalk_surface_above_ring": "s",
  "stalk_surface_below_ring": "s",
  "stalk_color_above_ring": "w",
  "stalk_color_below_ring": "w",
  "veil_color": "w",
  "ring_number": "o",
  "ring_type": "p",
  "spore_print_color": "n",
  "population": "n",
  "habitat": "g"
}

### 5. Predict Batch: Multiple mushrooms in one call
POST {{base}}/mushroom/predict/batch
Content-Type: application/json

[
  {
    "cap_shape": "x", "cap_surface": "s", "cap_color": "n", "bruises": "t", "odor": "p",
    "gill_attachment": "f", "gill_spacing": "c", "gill_size": "n", "gill_color": "k",
    "stalk_shape": "e", "stalk_root": "e", "stalk_surface_above_ring": "s", "stalk_surface_below_ring": "s",
    "stalk_color_above_ring": "w", "stalk_color_below_ring": "w", "veil_color": "w",
    "ring_number": "o", "ring_type": "p", "spore_print_color": "k", "population": "s", "habitat": "u"
  },
  {
    "cap_shape": "x", "cap_surface": "s", "cap_color": "y", "bruises": "t", "odor": "a",
    "gill_attachment": "f", "gill_spacing": "c", "gill_size": "b", "gill_color": "k",
    "stalk_shape": "e", "stalk_root": "c", "stalk_surface_above_ring": "s", "stalk_surface_below_ring": "s",
    "stalk_color_above_ring": "w", "stalk_color_below_ring": "w", "veil_color": "w",
    "ring_number": "o", "ring_type": "p", "spore_print_color": "n", "population": "n", "habitat": "g"
  }
]

### 6. Validation Error: Invalid length and extra unknown field (Returns 422)
POST {{base}}/mushroom/predict
Content-Type: application/json

{
  "cap_shape": "toolong",
  "cap_surface": "s",
  "favorite_song": "bohemian rhapsody"
}
